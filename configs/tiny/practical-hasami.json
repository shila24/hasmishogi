{
  "schema_version": 1,
  "run": {
    "run_id": "tiny-practical",
    "output_dir": "runs",
    "iterations": 1,
    "seed": 2,
    "backend": "cpp",
    "checkpoint_every": 1,
    "eval_every": 0,
    "keep_checkpoints": 2,
    "notes": "SYNTHETIC SMOKE only: bootstraps a tiny engine and synthetic calibration; no strength claims."
  },
  "device": {
    "device": "cpu",
    "amp": "off",
    "threads": 2,
    "deterministic": false,
    "inference_batch": 64
  },
  "algorithm": {
    "name": "practical",
    "params": {
      "bootstrap_tiny": true,
      "games_per_iteration": 2,
      "rollouts_per_start": 2,
      "batch_games": 2,
      "default_level": 3,
      "on_policy_rate": 0.25
    }
  },
  "network": {
    "name": "mlp",
    "params": {
      "hidden": 16,
      "layers": 1,
      "aux_heads": {
        "practical": {
          "shape": [
            3,
            3
          ],
          "activation": "sigmoid"
        },
        "slip": {
          "shape": [
            3
          ],
          "activation": "sigmoid"
        }
      }
    }
  },
  "encoder": {
    "name": "hasami-enc-v1",
    "params": {}
  },
  "selfplay": {
    "games_per_iteration": 2,
    "max_plies": 4,
    "workers": 1,
    "temperature": 1.0,
    "temperature_plies": 20,
    "symmetry_augmentation": false,
    "truncation_value": 0.0
  },
  "replay": {
    "capacity": 128,
    "batch_size": 8,
    "min_size": 1,
    "persist": false
  },
  "optimizer": {
    "name": "adam",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "grad_clip": 1.0,
    "updates_per_iteration": 2,
    "lr_schedule": "constant"
  },
  "opponents": {
    "strategy": "self",
    "pool_size": 2,
    "snapshot_every": 0,
    "classical": [
      "random"
    ],
    "classical_weight": 0.0,
    "exploiter_every": 0,
    "params": {}
  },
  "evaluation": {
    "games": 0,
    "opponents": [
      "random"
    ],
    "swap_sides": true,
    "max_plies": 40,
    "limits": {
      "max_depth": 1,
      "time_ms": 200,
      "node_limit": 20000
    },
    "simulations": 0,
    "save_records": false
  },
  "datastore": {
    "enabled": false,
    "max_games": 8,
    "max_bytes": 1048576,
    "path": null
  }
}
